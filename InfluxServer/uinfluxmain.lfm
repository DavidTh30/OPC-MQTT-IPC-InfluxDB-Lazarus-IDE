    object SpinRet: TSpinEdit
      Left = 752
      Height = 23
      Top = 11
      Width = 60
      MaxValue = 36500
      OnChange = SpinRetChange
      TabOrder = 4
    end
    object ButtonStart: TButton
      Left = 886
      Height = 30
      Top = 8
      Width = 100
      Anchors = [akTop, akRight]
      Caption = 'Start'
      OnClick = ButtonStartClick
      TabOrder = 5
    end
    object ShapeState: TShape
      Left = 12
      Height = 22
      Top = 50
      Width = 22
      Brush.Color = clSilver
      Shape = stCircle
    end
    object LabelState: TLabel
      Left = 44
      Height = 22
      Top = 52
      Width = 640
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      Caption = 'Server stopped'
      Font.Style = [fsBold]

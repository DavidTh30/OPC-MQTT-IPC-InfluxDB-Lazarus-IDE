      Left = 446
      Height = 19
      Top = 13
      Width = 165
      Caption = 'Create databases on write'
      Checked = True
      OnChange = CheckAutoCreateChange
      State = cbChecked
      TabOrder = 3
    end
    object LabelRet: TLabel
      Left = 620
      Height = 15
      Top = 15
      Width = 128
      Caption = 'Retention days (0 = all)'

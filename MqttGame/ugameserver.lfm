      end
      item
        Title.Caption = 'Colour'
        Width = 70
      end
      item
        Title.Caption = 'Client id'
        Width = 170
      end>
    FixedCols = 0
    Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goColSizing, goRowSelect, goSmoothScroll]
    RowCount = 1

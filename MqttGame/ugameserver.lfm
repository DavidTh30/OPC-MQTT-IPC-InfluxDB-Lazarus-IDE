  object GridPlayers: TStringGrid
    Left = 0
    Height = 268
    Top = 112
    Width = 900
    Align = alClient
    ColCount = 9
    Columns = <
      item
        Title.Caption = 'Name'
        Width = 140
      end
      item
        Title.Caption = 'Type'
        Width = 60
      end
      item
        Title.Caption = 'State'
        Width = 80
      end
      item
        Title.Caption = 'Score'
        Width = 55
      end
      item
        Title.Caption = 'Best'
        Width = 55
      end
      item

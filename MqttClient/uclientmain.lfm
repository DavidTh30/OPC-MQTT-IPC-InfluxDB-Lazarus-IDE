      item
        Title.Caption = 'Count'
        Width = 55
      end    
      item
        Title.Caption = 'Time'
        Width = 85
      end>
    FixedCols = 0
    Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goColSizing, goRowSelect, goThumbTracking, goSmoothScroll]

    Align = alClient
    TabIndex = 0
    TabOrder = 1
    object TabGen: TTabSheet
      Caption = 'Generator'
      ClientHeight = 367
      ClientWidth = 952
      object GridGen: TStringGrid
        Left = 0
        Height = 327
        Top = 0
        Width = 952
